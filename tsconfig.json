{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", ".opencode", ".tmp"]
}
